{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vinit-thummar/peppol-interop-lab/schema/scenario-v1alpha1.schema.json",
  "title": "Peppol Interop Lab Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "specifications", "requires", "steps"],
  "properties": {
    "apiVersion": { "const": "peppol-interop-lab/v1alpha1" },
    "kind": { "const": "Scenario" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "specifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smp", "as4", "sbdh"],
      "properties": {
        "smp": { "type": "string" },
        "as4": { "type": "string" },
        "sbdh": { "type": "string" }
      }
    },
    "requires": {
      "type": "array",
      "items": { "enum": ["SMP_LOOKUP", "SMP_PROVISION", "AS4_SEND", "AS4_RECEIVE", "AP_SUBMIT", "TRANSACTION_STATUS", "EVIDENCE", "FAULT_INJECTION"] },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "action", "expect"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "with": { "type": "object" },
          "expect": {
            "type": "object",
            "properties": {
              "status": { "type": "integer", "minimum": 100, "maximum": 599 },
              "outcome": { "type": "string" },
              "contains": { "type": "array", "items": { "type": "string" } },
              "notContains": { "type": "array", "items": { "type": "string" } },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "maxDurationMs": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
